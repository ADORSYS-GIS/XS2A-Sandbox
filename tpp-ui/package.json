{
  "name": "tpp-ui",
  "version": "4.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4205 --proxy-config proxy.conf.json",
    "start:proxy:dev": "ng serve --port=4205 --proxy-config=proxy.dev.conf.json",
    "build": "ng build",
    "build:prod": "ng build --prod",
    "test": "ng test",
    "test-ci": "ng test --browsers ChromeHeadless --watch=false",
    "test-coverage": "ng test --code-coverage",
    "lint": "npx eslint src/app/. ",
    "lint:fix": "npx eslint src/app/. --fix",
    "e2e": "ng e2e",
    "prettier": "prettier --write .",
    "prettier-check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ],
    "*.{html,css,less,ejs}": [
      "prettier --write",
      "git add"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^12.2.17",
    "@angular/cdk": "^12.2.13",
    "@angular/common": "^12.2.17",
    "@angular/compiler": "^12.2.17",
    "@angular/core": "^12.2.17",
    "@angular/forms": "^12.2.17",
    "@angular/material": "^12.2.13",
    "@angular/platform-browser": "^12.2.17",
    "@angular/platform-browser-dynamic": "^12.2.17",
    "@angular/router": "^12.2.17",
    "@auth0/angular-jwt": "^5.0.2",
    "@ng-bootstrap/ng-bootstrap": "^10.0.0",
    "@ngxs/devtools-plugin": "^3.8.0",
    "@ngxs/logger-plugin": "^3.8.0",
    "@ngxs/store": "3.8.0",
    "bootstrap": "^4.6.0",
    "browser-detect": "^0.2.28",
    "core-js": "^3.8.3",
    "css-vars-ponyfill": "^2.4.3",
    "custom-event-polyfill": "^1.0.7",
    "font-awesome": "^4.7.0",
    "jasmine": "^3.6.4",
    "jszip": "^3.6.0",
    "material-icons": "^0.5.3",
    "ng-http-loader": "10.1.0",
    "ng2-file-upload": "1.4.0",
    "ngx-bootstrap": "7.1.2",
    "ngx-filter-pipe": "^2.1.2",
    "rxjs": "^6.6.3",
    "rxjs-compat": "^6.5.5",
    "tslib": "^2.1.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~12.2.18",
    "@angular/cli": "~12.2.18",
    "@angular/compiler-cli": "^12.2.17",
    "@angular/language-service": "^12.2.17",
    "@angular/localize": "^12.2.17",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "^5.19.0",
    "@typescript-eslint/parser": "^5.19.0",
    "codelyzer": "^6.0.1",
    "eslint": "^8.13.0",
    "eslint-plugin-angular": "^4.1.0",
    "eslint-plugin-autofix": "^1.1.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "jquery": "^3.5.1",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-firefox-launcher": "^2.1.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "popper.js": "^1.16.1",
    "prettier": "^2.6.0",
    "protractor": "~7.0.0",
    "sass": "^1.32.8",
    "ts-node": "~9.1.1",
    "typescript": "^4.3.5"
  }
}